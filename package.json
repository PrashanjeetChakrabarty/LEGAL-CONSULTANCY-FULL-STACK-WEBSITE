{
  "name": "fv-legal-solutions",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "admin", "server"],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:admin\" \"npm run dev:server\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=frontend && npm run build --workspace=admin && npm run build --workspace=server",
    "start": "npx pm2 start ecosystem.config.js",
    "stop": "npx pm2 stop ecosystem.config.js",
    "restart": "npx pm2 restart ecosystem.config.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
